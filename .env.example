MONGO_URI=your_mongodb_connection_string_here
PORT=your_port_here
JWT_SECRET=your_secret_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Where the frontend is hosted — used to build /verify/:token links in
# verification emails. Falls back to the first ALLOWED_ORIGINS entry if unset.
FRONTEND_URL=http://localhost:5173

# SMTP (provider-agnostic via nodemailer). Easiest free starter: Gmail SMTP
# with an App Password — generate at https://myaccount.google.com/apppasswords.
# Other options: Resend (smtp.resend.com:465, user='resend'), Brevo
# (smtp-relay.brevo.com:587), AWS SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Nocturne <noreply@nocturne.app>