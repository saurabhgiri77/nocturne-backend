MONGO_URI=your_mongodb_connection_string_here
PORT=your_port_here
JWT_SECRET=your_secret_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Where the frontend is hosted — used to build /verify/:token links in
# verification emails. Falls back to the first ALLOWED_ORIGINS entry if unset.
FRONTEND_URL=http://localhost:5173

# SMTP (provider-agnostic via nodemailer). Resend works out of the box from
# cloud hosts like Render — Gmail SMTP works locally but times out from
# Render's egress range. Free tier: 100/day, 3k/month.
#   1. Sign up at resend.com, get an API key.
#   2. SMTP_PASS is the API key (no spaces).
#   3. EMAIL_FROM uses Resend's sandbox domain for testing; switch to a
#      verified domain (e.g. noreply@yourdomain.com) once you own one.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
EMAIL_FROM=Bump <onboarding@resend.dev>