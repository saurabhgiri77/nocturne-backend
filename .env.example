MONGO_URI=your_mongodb_connection_string_here
PORT=your_port_here
JWT_SECRET=your_secret_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Where the frontend is hosted — used to build /verify/:token links in
# verification emails. Falls back to the first ALLOWED_ORIGINS entry if unset.
FRONTEND_URL=http://localhost:5173

# Email — uses Resend's HTTPS API (port 443) so it works from cloud hosts
# like Render that block outbound SMTP. Free tier: 100/day, 3k/month.
#   1. Sign up at resend.com, get an API key.
#   2. EMAIL_FROM defaults to onboarding@resend.dev (works without domain
#      verification, but you can only send to YOUR account email). Verify
#      a domain in Resend to send to anyone — then switch to noreply@your-
#      domain.com here.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Bump <onboarding@resend.dev>

# Optional SMTP fallback (used only when RESEND_API_KEY is unset). Works with
# any nodemailer-compatible host: Gmail, Brevo, SES, etc. Gmail SMTP works
# locally but times out from Render — use Resend HTTP API on cloud hosts.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# Mini games — master kill switch for the in-call game layer. Set to "false"
# to disable every game_* socket handler without a frontend redeploy. The
# frontend's VITE_GAMES_ENABLED only hides the button; THIS is authoritative.
GAMES_ENABLED=true
